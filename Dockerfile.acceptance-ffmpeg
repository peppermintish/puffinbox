# Local/CI test input only. This image supplies a separate distro build of
# FFmpeg; it is never used in the permissive-only project release image.
FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
