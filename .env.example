# Copy this file to .env before starting the Compose stack. Use a long,
# URL-safe random database password. This example is not a credential.
POSTGRES_DB=puffinbox
POSTGRES_USER=puffinbox
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value

# Host-side listener. Keep loopback for local use; set a protected LAN address
# only after configuring TLS and firewall rules at the proxy/network layer.
PUFFINBOX_PORT=127.0.0.1:8096
PUFFINBOX_SERVER_NAME=Puffinbox
MEDIA_ROOT=./media
# Optional public HTTP(S) origin reported in System/Info. Use an origin only,
# for example https://media.example.net; do not include a path or credentials.
# An HTTPS origin also requires PUFFINBOX_TRUSTED_PROXIES below to identify the
# reverse proxy and PUFFINBOX_COOKIE_SECURE=true.
PUFFINBOX_PUBLIC_BASE_URL=

# Leave false for loopback HTTP. Set true only behind TLS or when serving HTTPS.
PUFFINBOX_COOKIE_SECURE=false
# Comma-separated proxy CIDRs only when requests arrive through trusted proxies.
# Required with an HTTPS public origin; list the actual proxy addresses only.
PUFFINBOX_TRUSTED_PROXIES=
# Optional comma-separated client CIDRs considered local by server policy.
PUFFINBOX_LOCAL_NETWORKS=
# Optional allowed cross-origin browser origins. Same-origin use needs no entry.
PUFFINBOX_CORS_ORIGINS=

# Optional DLNA MediaServer. It stays disabled unless you add the explicit
# docker-compose.dlna.yml overlay and set an interface IPv4 address plus the
# matching HTTP origin. The overlay uses host networking for SSDP multicast.
PUFFINBOX_DLNA_ENABLED=false
PUFFINBOX_DLNA_INTERFACE_ADDRESS=
PUFFINBOX_DLNA_ADVERTISED_ORIGIN=
PUFFINBOX_POSTGRES_HOST_PORT=55432

# Optional first-start admin seeding. Leave blank to use the one-time setup
# token in the server data directory.
PUFFINBOX_BOOTSTRAP_ADMIN_USERNAME=
PUFFINBOX_BOOTSTRAP_ADMIN_PASSWORD=

# Optional only for docker-compose.ffmpeg-runtime.yml. Use a locally supplied
# Debian-compatible Linux image with FFmpeg, ffprobe, runtime libraries, and
# its complete /usr/share/doc license/source notices.
OPERATOR_FFMPEG_IMAGE=

# Optional for docker-compose.tls.yml: mount the operator's CA bundle for
# outbound HTTPS and TLS database connections. Trust roots are not bundled.
TLS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
